+      }
+    }
+    if (auto_applied_any) {
+      break;
+    }
+  }
+  const pid_t game_pid = runtime_->process.pid;
+  const bool frozen = auto_applied_any && ::kill(game_pid, SIGSTOP) == 0;
+  if (auto_applied_any && !frozen) {
+    LOG_WARN("[service] auto-apply could not suspend pid=%d errno=%d",
+             static_cast<int>(game_pid), errno);
+  }
+  for (const auto &loaded : runtime_->files) {
+    for (size_t i = 0; i < loaded->file.cheat_count; ++i) {
+      auto &entry = loaded->file.cheats[i];
+      if (!entry.enabled) {
+        continue;
+      }
+      entry.enabled = false;
+      std::string status;
+      if (runtime_->applier.toggle(runtime_->context, loaded->file,
+                                   static_cast<int>(i), status,
+                                   loaded->path) < 0) {
+        LOG_ERROR("[service] auto-apply failed %s index=%zu (%s): %s",
+                  loaded->path.c_str(), i, entry.name, status.c_str());
+        entry.enabled = false;
+      } else {
+        LOG_INFO("[Cheat] auto-applied '%s' (%s)", entry.name,
+                 loaded->path.c_str());
+      }
+    }
+  }
+  if (frozen) {
+    ::kill(game_pid, SIGCONT);
+    LOG_INFO("[service] auto-apply complete, resumed pid=%d",
+             static_cast<int>(game_pid));
+  }
   return 0;
 }
 
