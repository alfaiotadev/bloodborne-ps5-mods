new file mode 100644
index 0000000..c03b695
--- /dev/null
+++ b/source/daemon/include/debug_probes.hpp
@@ -0,0 +1,219 @@
+/* Copyright (C) 2026 OnionHEN / LightningMods
+ *
+ * Debug probes: tiny text config that tells the daemon which game-memory
+ * values to show in the overlay DBG group. Pure logic (no SDK dependencies)
+ * so it can be unit-tested on the host.
+ *
+ * File format (one probe per line, '#' starts a comment):
+ *
+ *   <title_id> <label> <base_hex> <deref 0|1> <name:size:offset_hex>...
+ *
+ *   CUSA03173 AA  5865ED0 1 FX:1:BBC TA:1:B8C
+ *   CUSA03173 RES 55289F8 0 W:4:0 H:4:4
+ *
+ * deref=1 reads an 8-byte pointer at base first and applies the field offsets
+ * to the pointed-to object; deref=0 applies them to base directly.
+ * size is 1, 2, 4 or 8. Values are printed as unsigned decimals.
+ */
+#pragma once
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace onion::daemon::probes {
+
+constexpr int kMaxProbes = 12;
+constexpr int kMaxFields = 6;
+constexpr size_t kDbgTextCap = 72; /* OnionFpsSample::dbg */
+
+struct Field {
+  char name[8];
+  uint8_t size;
+  uint32_t off;
+};
+
+struct Probe {
+  char title[16];
+  char label[8];
+  uint64_t base;
+  bool deref;
+  int nfields;
+  Field fields[kMaxFields];
+};
+
+/** Reads `n` bytes at `va` from the target. Returns true on success. */
+using ReadFn = bool (*)(void *ctx, uint64_t va, void *dst, size_t n);
+
+namespace detail {
+
+inline bool parse_hex(const char *s, uint64_t *out) {
+  if (!s || !*s)
+    return false;
+  char *end = nullptr;
+  const unsigned long long v = std::strtoull(s, &end, 16);
+  if (end == s || *end != '\0')
+    return false;
+  *out = static_cast<uint64_t>(v);
+  return true;
+}
+
+inline void copy_cstr(char *dst, size_t cap, const char *src, size_t len) {
+  const size_t n = len < cap - 1 ? len : cap - 1;
+  std::memcpy(dst, src, n);
+  dst[n] = '\0';
+}
+
+/* Splits `line` in place on spaces/tabs; returns token count (max `cap`). */
+inline int tokenize(char *line, char **tok, int cap) {
+  int n = 0;
+  char *p = line;
+  while (*p && n < cap) {
+    while (*p == ' ' || *p == '\t')
+      ++p;
+    if (!*p)
+      break;
+    tok[n++] = p;
+    while (*p && *p != ' ' && *p != '\t')
+      ++p;
+    if (*p)
+      *p++ = '\0';
+  }
+  return n;
+}
+
+inline bool parse_field(const char *tok, Field *f) {
+  /* name:size:offset_hex */
+  const char *c1 = std::strchr(tok, ':');
+  if (!c1)
+    return false;
+  const char *c2 = std::strchr(c1 + 1, ':');
+  if (!c2)
+    return false;
+  const size_t name_len = static_cast<size_t>(c1 - tok);
+  if (name_len == 0 || name_len >= sizeof(f->name))
+    return false;
+  char size_buf[8];
+  const size_t size_len = static_cast<size_t>(c2 - (c1 + 1));
+  if (size_len == 0 || size_len >= sizeof(size_buf))
+    return false;
+  copy_cstr(size_buf, sizeof(size_buf), c1 + 1, size_len);
+  const long sz = std::strtol(size_buf, nullptr, 10);
+  if (sz != 1 && sz != 2 && sz != 4 && sz != 8)
+    return false;
+  uint64_t off = 0;
+  if (!parse_hex(c2 + 1, &off) || off > 0xFFFFFFFFull)
+    return false;
+  copy_cstr(f->name, sizeof(f->name), tok, name_len);
+  f->size = static_cast<uint8_t>(sz);
+  f->off = static_cast<uint32_t>(off);
+  return true;
+}
+
+} // namespace detail
+
+/**
+ * Parses `text` (NUL-terminated, not modified). Writes up to `max` probes to
+ * `out`; malformed lines are skipped. Returns the number of probes parsed.
+ */
+inline int parse(const char *text, Probe *out, int max) {
+  int count = 0;
+  if (!text || !out)
+    return 0;
+  const char *p = text;
+  while (*p && count < max) {
+    const char *eol = std::strchr(p, '\n');
+    const size_t len = eol ? static_cast<size_t>(eol - p) : std::strlen(p);
+    char line[256];
+    if (len < sizeof(line)) {
+      std::memcpy(line, p, len);
+      line[len] = '\0';
+      char *tok[4 + kMaxFields + 1];
+      const int nt = detail::tokenize(line, tok, 4 + kMaxFields + 1);
+      if (nt >= 5 && tok[0][0] != '#') {
+        Probe pr{};
+        uint64_t base = 0;
+        const bool ok_hdr = std::strlen(tok[0]) < sizeof(pr.title) &&
+                            std::strlen(tok[1]) < sizeof(pr.label) &&
+                            detail::parse_hex(tok[2], &base) &&
+                            (tok[3][0] == '0' || tok[3][0] == '1') &&
+                            tok[3][1] == '\0';
+        if (ok_hdr) {
+          std::strcpy(pr.title, tok[0]);
+          std::strcpy(pr.label, tok[1]);
+          pr.base = base;
+          pr.deref = tok[3][0] == '1';
+          bool ok = true;
+          for (int i = 4; i < nt && pr.nfields < kMaxFields; ++i) {
+            if (!detail::parse_field(tok[i], &pr.fields[pr.nfields])) {
+              ok = false;
+              break;
+            }
+            ++pr.nfields;
+          }
+          if (ok && pr.nfields > 0)
+            out[count++] = pr;
+        }
+      }
+    }
+    if (!eol)
+      break;
+    p = eol + 1;
+  }
+  return count;
+}
+
+/**
+ * Formats all probes matching `title` as "LABEL NAME:val NAME:val  LABEL2 ...".
+ * Unreadable values print as '?'. Output is always NUL-terminated and
+ * truncated to `cap`. Returns the string length.
+ */
+inline size_t format(const Probe *probes, int n, const char *title, ReadFn rd,
+                     void *ctx, char *out, size_t cap) {
+  if (!out || cap == 0)
+    return 0;
+  out[0] = '\0';
+  size_t used = 0;
+  auto append = [&](const char *s) {
+    const size_t l = std::strlen(s);
+    const size_t room = cap - 1 - used;
+    const size_t c = l < room ? l : room;
+    std::memcpy(out + used, s, c);
+    used += c;
+    out[used] = '\0';
+  };
+  for (int i = 0; i < n; ++i) {
+    const Probe &pr = probes[i];
+    if (std::strcmp(pr.title, title) != 0)
+      continue;
+    if (used > 0)
+      append("  ");
+    append(pr.label);
+    uint64_t obj = pr.base;
+    bool obj_ok = true;
+    if (pr.deref) {
+      uint64_t ptr = 0;
+      obj_ok = rd(ctx, pr.base, &ptr, sizeof(ptr)) && ptr != 0;
+      obj = ptr;
+    }
+    for (int k = 0; k < pr.nfields; ++k) {
+      const Field &f = pr.fields[k];
+      char buf[40];
+      uint64_t v = 0;
+      if (obj_ok && rd(ctx, obj + f.off, &v, f.size)) {
+        /* little endian: the low `size` bytes of v hold the value */
+        if (f.size < 8)
+          v &= (1ull << (8 * f.size)) - 1ull;
+        std::snprintf(buf, sizeof(buf), " %s:%llu", f.name,
+                      static_cast<unsigned long long>(v));
+      } else {
+        std::snprintf(buf, sizeof(buf), " %s:?", f.name);
+      }
+      append(buf);
+    }
+  }
+  return used;
+}
+
+} // namespace onion::daemon::probes
