+/* Creating the runtime cheat session at BigAppStarted (exec time) lets the
+ * util daemon apply JSON "enabled": true cheats before the game runs its
+ * initialization — the timing framerate patches require. Mid-run toggling
+ * of those leaves the game's already-initialized frame loop at its old
+ * rate and crashes on gameplay entry. */
+/* IPC_Client is shared with other lifecycle work; serialize our own use. */
+pthread_mutex_t g_cheat_prime_lock = PTHREAD_MUTEX_INITIALIZER;
+
+/* Asks the util daemon for the runtime cheat list, which creates the session
+ * and triggers the exec-time auto-apply. */
+bool prime_cheat_session(const std::string &title_id, pid_t event_pid,
+                         const onion_bigapp_process_t &process) {
+  pthread_mutex_lock(&g_cheat_prime_lock);
+  std::string cheats;
+  const bool ok = IPC_Client::getInstance(true).GetGameCheats(
+      title_id, cheats, "runtime", process.pid, process.appid,
+      process.process_name, process.session_generation);
+  pthread_mutex_unlock(&g_cheat_prime_lock);
+  if (!ok) {
+    LOG_WARN("[lifecycle] cheat session request failed pid=%d tid=%s",
+             static_cast<int>(event_pid), title_id.c_str());
+  } else {
+    LOG_INFO("[lifecycle] cheat session primed for %s (pid=%d)",
+             title_id.c_str(), static_cast<int>(event_pid));
+  }
+  return ok;
+}
+
+struct CheatRetryContext {
+  pid_t pid;
+  std::string title_id;
+};
+
+/* The "running big app" query can still be unavailable at the BigAppStarted
+ * event (race seen on 2026-10-01: rc=-1, session never created, no mods
+ * applied). Poll briefly instead of giving up; the game is still in its
+ * early startup, so applying within a few hundred ms is still exec-time. */
+void *cheat_session_retry_thread(void *arg) noexcept {
+  std::unique_ptr<CheatRetryContext> ctx(static_cast<CheatRetryContext *>(arg));
+  constexpr int kStepMs = 10;
+  constexpr int kMaxMs = 3000;
+  for (int waited = 0; waited <= kMaxMs; waited += kStepMs) {
+    if (!isProcessAlive(ctx->pid)) {
+      LOG_DEBUG("[lifecycle] cheat session retry: pid=%d exited after %d ms",
+                static_cast<int>(ctx->pid), waited);
+      return nullptr;
+    }
+    onion_bigapp_process_t process{};
+    const int rc = onion_resolve_running_bigapp(&process);
+    if ((rc == 0 || rc == -2) && process.pid > 0) {
+      if (process.pid != ctx->pid) {
+        LOG_WARN("[lifecycle] cheat session retry: running app pid=%d differs "
+                 "from started pid=%d; not priming",
+                 static_cast<int>(process.pid), static_cast<int>(ctx->pid));
+        return nullptr;
+      }
+      LOG_INFO("[lifecycle] cheat session identity available after %d ms "
+               "(pid=%d)",
+               waited, static_cast<int>(ctx->pid));
+      prime_cheat_session(ctx->title_id, ctx->pid, process);
+      return nullptr;
+    }
+    usleep(kStepMs * 1000);
+  }
+  LOG_WARN("[lifecycle] cheat session: bigapp identity still unavailable "
+           "after %d ms (pid=%d tid=%s); mods will not auto-apply",
+           kMaxMs, static_cast<int>(ctx->pid), ctx->title_id.c_str());
+  return nullptr;
+}
+
+/* Creating the runtime cheat session at BigAppStarted (exec time) lets the
+ * util daemon apply JSON "enabled": true cheats before the game runs its
+ * initialization — the timing framerate patches require. Mid-run toggling
+ * of those leaves the game's already-initialized frame loop at its old
+ * rate and crashes on gameplay entry. */
+class CheatSessionLifecycleSubscriber final
+    : public onion::lifecycle::ISubscriber {
+public:
+  int priority() const noexcept override { return 50; }
+
+  bool on_event(const onion::lifecycle::Event &event) noexcept override {
+    if (event.type != onion::lifecycle::EventType::BigAppStarted) {
+      return true;
+    }
+    onion_bigapp_process_t process{};
+    const int rc = onion_resolve_running_bigapp(&process);
+    if ((rc != 0 && rc != -2) || process.pid <= 0) {
+      LOG_DEBUG("[lifecycle] cheat session: bigapp identity unavailable "
+                "rc=%d pid=%d; retrying in background",
+                rc, static_cast<int>(event.app.pid));
+      auto *ctx = new (std::nothrow) CheatRetryContext{
+          event.app.pid, std::string(event.app.title_id)};
+      pthread_t thr = nullptr;
+      if (!ctx || pthread_create(&thr, nullptr, cheat_session_retry_thread,
+                                 ctx) != 0) {
+        LOG_WARN("[lifecycle] cheat session retry thread failed pid=%d",
+                 static_cast<int>(event.app.pid));
+        delete ctx;
+      } else {
+        pthread_detach(thr);
+      }
+      return true;
+    }
+    prime_cheat_session(event.app.title_id, event.app.pid, process);
+    return true;
+  }
+};
+
