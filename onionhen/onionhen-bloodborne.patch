+
+  /* Auto-apply mods whose JSON marks them "enabled": true. This runs at
+   * session start — the game process has just exec'd but has not run its
+   * initialization yet, which is the timing patch-style cheats (framerate
+   * unlocks etc.) require. Mid-run toggling of those crashes games.
+   * The process is suspended for the duration: a partially patched frame
+   * loop crashes the title the moment it executes it. */
+  bool auto_applied_any = false;
+  for (const auto &loaded : runtime_->files) {
+    for (size_t i = 0; i < loaded->file.cheat_count; ++i) {
+      if (loaded->file.cheats[i].enabled) {
