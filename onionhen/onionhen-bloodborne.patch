diff --git a/source/daemon/source/daemon_probes.cpp b/source/daemon/source/daemon_probes.cpp
new file mode 100644
index 0000000..b4c4a29
--- /dev/null
+++ b/source/daemon/source/daemon_probes.cpp
@@ -0,0 +1,173 @@
+/* Copyright (C) 2026 OnionHEN / LightningMods
+ *
+ * Overlay debug probes: reads small values from the running game's memory
+ * (config: /data/OnionHEN/debug_probes.txt, see debug_probes.hpp) and the
+ * game's total mapped memory, and attaches both to every published FPS
+ * sample so ShellUI can show them without any extra IPC.
+ */
+#include "daemon_ops.hpp"
+#include "debug_probes.hpp"
+
+#include <onion/fps_publish.hpp>
+#include <onion/log.h>
+#include <onion/proc_dmap.h>
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <pthread.h>
+#include <sys/stat.h>
+#include <sys/sysctl.h>
+#include <sys/types.h>
+#include <time.h>
+#include <unistd.h>
+
+#ifndef KERN_PROC_VMMAP
+#define KERN_PROC_VMMAP 32
+#endif
+
+namespace {
+
+using namespace onion::daemon::probes;
+
+constexpr const char *kProbeFile = "/data/OnionHEN/debug_probes.txt";
+constexpr uint64_t kRefreshNs = 500ull * 1000ull * 1000ull;   /* probes: 0.5 s */
+constexpr uint64_t kMemRefreshNs = 2000ull * 1000ull * 1000ull; /* vm map: 2 s */
+constexpr uint64_t kFileCheckNs = 5000ull * 1000ull * 1000ull;  /* config: 5 s */
+
+pthread_mutex_t g_lock = PTHREAD_MUTEX_INITIALIZER;
+
+Probe g_probes[kMaxProbes];
+int g_probe_count = 0;
+time_t g_file_mtime = 0;
+uint64_t g_file_check_ns = 0;
+
+int g_cache_pid = -1;
+char g_cache_tid[16] = {};
+char g_cache_dbg[kDbgTextCap] = {};
+uint64_t g_cache_dbg_ns = 0;
+uint32_t g_cache_mem_mb = 0;
+uint64_t g_cache_mem_ns = 0;
+
+uint64_t mono_ns() {
+  struct timespec ts;
+  if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0)
+    return 0;
+  return static_cast<uint64_t>(ts.tv_sec) * 1000000000ull +
+         static_cast<uint64_t>(ts.tv_nsec);
+}
+
+void reload_probes_if_changed(uint64_t now) {
+  if (g_file_check_ns != 0 && now - g_file_check_ns < kFileCheckNs)
+    return;
+  g_file_check_ns = now;
+  struct stat st;
+  if (stat(kProbeFile, &st) != 0) {
+    if (g_probe_count != 0)
+      LOG_INFO("[probes] %s removed; probes disabled", kProbeFile);
+    g_probe_count = 0;
+    g_file_mtime = 0;
+    return;
+  }
+  if (st.st_mtime == g_file_mtime)
+    return;
+  g_file_mtime = st.st_mtime;
+  const int fd = open(kProbeFile, O_RDONLY);
+  if (fd < 0)
+    return;
+  static char buf[4096];
+  const ssize_t n = read(fd, buf, sizeof(buf) - 1);
+  close(fd);
+  if (n <= 0) {
+    g_probe_count = 0;
+    return;
+  }
+  buf[n] = '\0';
+  g_probe_count = parse(buf, g_probes, kMaxProbes);
+  LOG_INFO("[probes] loaded %d probe(s) from %s", g_probe_count, kProbeFile);
+}
+
+bool read_game(void *ctx, uint64_t va, void *dst, size_t n) {
+  const pid_t pid = static_cast<pid_t>(reinterpret_cast<intptr_t>(ctx));
+  return onion_proc_copyout(pid, va, dst, n) == 0;
+}
+
+/* Sum of all vm map entries (FreeBSD struct kinfo_vmentry layout), in MB. */
+uint32_t game_mapped_mb(pid_t pid) {
+  int mib[4] = {CTL_KERN, KERN_PROC, KERN_PROC_VMMAP, static_cast<int>(pid)};
+  size_t len = 0;
+  if (sysctl(mib, 4, nullptr, &len, nullptr, 0) != 0 || len == 0)
+    return 0;
+  len += len / 4 + 4096; /* the map can grow between the two calls */
+  unsigned char *buf = static_cast<unsigned char *>(std::malloc(len));
+  if (!buf)
+    return 0;
+  uint64_t total = 0;
+  if (sysctl(mib, 4, buf, &len, nullptr, 0) == 0) {
+    size_t off = 0;
+    while (off + 24 <= len) {
+      int32_t sz = 0;
+      std::memcpy(&sz, buf + off, sizeof(sz));
+      if (sz < 24 || off + static_cast<size_t>(sz) > len)
+        break;
+      uint64_t start = 0, end = 0;
+      std::memcpy(&start, buf + off + 8, sizeof(start));
+      std::memcpy(&end, buf + off + 16, sizeof(end));
+      if (end > start)
+        total += end - start;
+      off += static_cast<size_t>(sz);
+    }
+  }
+  std::free(buf);
+  return static_cast<uint32_t>(total >> 20);
+}
+
+void decorate(OnionFpsSample &s) {
+  std::memset(s.dbg, 0, sizeof(s.dbg));
+  s.game_mem_mb = 0;
+  if (s.pid <= 0 || s.title_id[0] == '\0')
+    return;
+
+  pthread_mutex_lock(&g_lock);
+  const uint64_t now = mono_ns();
+  const bool new_target = g_cache_pid != s.pid ||
+                          std::strncmp(g_cache_tid, s.title_id,
+                                       sizeof(g_cache_tid)) != 0;
+  if (new_target) {
+    g_cache_pid = s.pid;
+    std::strncpy(g_cache_tid, s.title_id, sizeof(g_cache_tid) - 1);
+    g_cache_dbg[0] = '\0';
+    g_cache_dbg_ns = 0;
+    g_cache_mem_mb = 0;
+    g_cache_mem_ns = 0;
+  }
+
+  if (g_cache_dbg_ns == 0 || now - g_cache_dbg_ns >= kRefreshNs) {
+    g_cache_dbg_ns = now;
+    reload_probes_if_changed(now);
+    if (g_probe_count > 0) {
+      format(g_probes, g_probe_count, g_cache_tid, read_game,
+             reinterpret_cast<void *>(static_cast<intptr_t>(s.pid)),
+             g_cache_dbg, sizeof(g_cache_dbg));
+    } else {
+      g_cache_dbg[0] = '\0';
+    }
+  }
+  if (g_cache_mem_ns == 0 || now - g_cache_mem_ns >= kMemRefreshNs) {
+    g_cache_mem_ns = now;
+    g_cache_mem_mb = game_mapped_mb(static_cast<pid_t>(s.pid));
+  }
+
+  std::memcpy(s.dbg, g_cache_dbg, sizeof(s.dbg) - 1);
+  s.game_mem_mb = g_cache_mem_mb;
+  pthread_mutex_unlock(&g_lock);
+}
+
+} // namespace
+
+void daemon_probes_init() noexcept {
+  onion::fps::set_decorator(&decorate);
+  LOG_INFO("[probes] overlay probe decorator registered");
+}
